{
  "name": "bern-mkt-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "deploy": "npx @vinext/cloudflare deploy --skip-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
